;; Caps Lock: Escape on tap; Left Control on hold or with another key.
;; Match the 500 ms tap window in the Karabiner dotfiles.
;; Keep physical Left Control and AltGr outside interception for compatibility.
(defcfg
  process-unmapped-keys (all-except lctl ralt)
  ;; Kanata 1.11 honors this for the whole Windows key-state check.
  ;; Pin 1.11: 1.12 runs part of that check anyway (upstream issue #2115).
  windows-sync-keystates no
  log-layer-changes no
)

(defsrc caps)

(deflayer default
  (tap-hold-press 500 500 esc lctl)
)
